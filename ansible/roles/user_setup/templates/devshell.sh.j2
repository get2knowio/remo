#!{{ remo_bash_path | default('/bin/bash') }}
# devshell - Launch a devcontainer shell for a project
# Managed by Ansible - do not edit manually
#
# Usage: devshell <repo>        - Start/attach to devcontainer for <repo>
#        devshell               - List available projects
#        devshell <repo> clone <github-url>  - Clone a repo and start devcontainer

set -e

PROJECTS_DIR="{{ dev_workspace_dir }}"

# Shared helpers (project index resolver, portability shims): beside this
# script, else in ~/.local/bin.
REMO_LIB_PATH="$(dirname "${BASH_SOURCE[0]}")/remo-lib.sh"
[ -r "$REMO_LIB_PATH" ] || REMO_LIB_PATH="$HOME/.local/bin/remo-lib.sh"
# shellcheck source=/dev/null
. "$REMO_LIB_PATH"

# Pin zellij's session namespace. zellij keeps session sockets in
# $XDG_RUNTIME_DIR/zellij, falling back to /tmp/zellij-$UID when that variable
# is unset — and ssh sets it only for a LOGIN SESSION (`ssh host`, a shell
# channel), not for `ssh host <command>`, which is what `remo shell -p`, the web
# console and the SSM connector all use. Without this the two contexts see
# different sessions on the same host: `remo shell` reattached while
# `remo shell -p NAME` created a duplicate in /tmp, and `remo-host sessions
# list` reported no active sessions to the console.
#
# Guarded on the directory existing, so a host without systemd-logind keeps
# today's /tmp fallback instead of pointing somewhere nothing will create.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

show_usage() {
    echo "Usage: devshell <repo> [clone <github-url>]"
    echo ""
    echo "Commands:"
    echo "  devshell <repo>                    Start/attach to devcontainer for <repo>"
    echo "  devshell <repo> clone <github-url> Clone repo and start devcontainer"
    echo ""
    echo "Available projects:"
    local plist name path src pstatus listed=false
    plist="$(remo_project_list 2>/dev/null || true)"
    if [ -n "$plist" ]; then
        while IFS=$'\t' read -r name path src pstatus; do
            [ "$pstatus" = "ok" ] || continue
            listed=true
            if [ -d "$path/.devcontainer" ]; then
                echo "  $name (has .devcontainer)"
            else
                echo "  $name"
            fi
        done <<<"$plist"
    fi
    if ! $listed; then
        echo "  (no projects found)"
    fi
}

if [ -z "$1" ]; then
    show_usage
    exit 0
fi

REPO_NAME="$1"
WORKSPACE_DIR="$(remo_project_path "$REPO_NAME" 2>/dev/null)" || WORKSPACE_DIR="${PROJECTS_DIR:-$HOME/projects}/$REPO_NAME"

# Handle clone command
if [ "$2" = "clone" ]; then
    if [ -z "$3" ]; then
        echo "Error: Please provide a GitHub URL to clone"
        echo "Usage: devshell <repo> clone <github-url>"
        exit 1
    fi
    GITHUB_URL="$3"
    
    if [ -d "$WORKSPACE_DIR" ]; then
        echo "Error: Directory $WORKSPACE_DIR already exists"
        exit 1
    fi
    
    echo "Cloning $GITHUB_URL to $WORKSPACE_DIR..."
    git clone "$GITHUB_URL" "$WORKSPACE_DIR"
    # With no PROJECTS_DIR nothing would find the checkout: index it.
    if [ -z "$PROJECTS_DIR" ]; then
        remo_project_add "$WORKSPACE_DIR" "$REPO_NAME" >/dev/null 2>&1 || true
    fi
fi

# Verify project directory exists
if [ ! -d "$WORKSPACE_DIR" ]; then
    echo "Error: Project directory not found: $WORKSPACE_DIR"
    echo ""
    show_usage
    exit 1
fi

# Change to project directory
cd "$WORKSPACE_DIR"

# Check for devcontainer configuration
if [ ! -d ".devcontainer" ] && [ ! -f ".devcontainer.json" ]; then
    echo "Warning: No .devcontainer configuration found in $WORKSPACE_DIR"
    echo "Starting devcontainer anyway (will use default configuration)..."
fi

# If inside zellij, rename the current tab to the project name
if [ -n "$ZELLIJ" ]; then
    zellij action rename-tab "$REPO_NAME"
fi

# Start the devcontainer if not already running
echo "Starting devcontainer for $REPO_NAME..."
{{ devcontainer_cli_bin }} up --workspace-folder "$WORKSPACE_DIR" {{ devcontainer_up_extra_args }}

# Loop to allow re-entry if there are local changes
while true; do
    # Execute a shell inside the devcontainer
    {{ devcontainer_cli_bin }} exec --workspace-folder "$WORKSPACE_DIR" /bin/bash -c 'if command -v zsh &> /dev/null; then exec zsh; else exec bash; fi'

    # Check for uncommitted or unpushed changes
    has_uncommitted=$({{ devcontainer_cli_bin }} exec --workspace-folder "$WORKSPACE_DIR" git status --porcelain 2>/dev/null)
    has_unpushed=$({{ devcontainer_cli_bin }} exec --workspace-folder "$WORKSPACE_DIR" git log @{u}.. --oneline 2>/dev/null)

    if [ -n "$has_uncommitted" ] || [ -n "$has_unpushed" ]; then
        echo ""
        echo "Warning: You have local changes that have not been pushed."
        read -p "Re-enter container? [y/N] " response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            continue
        fi
    fi

    break
done

# When we exit the devcontainer, rename tab back to "host"
if [ -n "$ZELLIJ" ]; then
    zellij action rename-tab "host"
fi

#!{{ remo_bash_path | default('/bin/bash') }}
# project-launch - Launch a project session non-interactively.
# Managed by Ansible - do not edit manually
#
# Usage:
#   project-launch --project NAME [--detach] [--exec SHELL_COMMAND]
#
# SHELL_COMMAND is a single string run via `bash -lc`, so variable
# expansion, pipes, `&&`, etc. all work as written.
#
# Modes:
#   Interactive (default):
#       Acts like "pick NAME in project-menu". Drops into the project's
#       zellij session whose default shell is remo-session-shell,
#       which brings up the devcontainer and execs the user's shell (or SHELL_COMMAND
#       when --exec is supplied — passed via REMO_DEVCONTAINER_CMD).
#
#   Detached (--detach):
#       Requires --exec. Brings up the devcontainer (or runs on the
#       host project dir if no .devcontainer), launches the command in
#       the background via remo_detach (nohup, +setsid where present) + `bash -lc`, captures
#       stdout/stderr to ~/.local/state/remo/<project>.log, and
#       returns immediately.
#
# Environment passed to SHELL_COMMAND (both modes):
#   REMO_INSTANCE  - hostname of the remo instance
#   REMO_PROJECT   - the project name

set -e

PROJECTS_DIR="{{ dev_workspace_dir }}"

# Shared helpers (project index resolver, portability shims): beside this
# script, else in ~/.local/bin.
REMO_LIB_PATH="$(dirname "${BASH_SOURCE[0]}")/remo-lib.sh"
[ -r "$REMO_LIB_PATH" ] || REMO_LIB_PATH="$HOME/.local/bin/remo-lib.sh"
# shellcheck source=/dev/null
. "$REMO_LIB_PATH"

# Pin zellij's session namespace. zellij keeps session sockets in
# $XDG_RUNTIME_DIR/zellij, falling back to /tmp/zellij-$UID when that variable
# is unset — and ssh sets it only for a LOGIN SESSION (`ssh host`, a shell
# channel), not for `ssh host <command>`, which is what `remo shell -p`, the web
# console and the SSM connector all use. Without this the two contexts see
# different sessions on the same host: `remo shell` reattached while
# `remo shell -p NAME` created a duplicate in /tmp, and `remo-host sessions
# list` reported no active sessions to the console.
#
# Guarded on the directory existing, so a host without systemd-logind keeps
# today's /tmp fallback instead of pointing somewhere nothing will create.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
# One session directory on macOS and the tool PATH recorded at setup (spec 030).
remo_pin_session_dir || exit 1
remo_load_local_path

PROJECT=""
DETACH=false
EXEC_CMD=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --project)
            PROJECT="$2"
            shift 2
            ;;
        --detach)
            DETACH=true
            shift
            ;;
        --exec)
            EXEC_CMD="$2"
            shift 2
            ;;
        -h|--help)
            sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "project-launch: unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

if [[ -z "$PROJECT" ]]; then
    echo "project-launch: --project NAME is required" >&2
    exit 2
fi

# Resolve through the project index, then PROJECTS_DIR; an unknown name is
# reported against PROJECTS_DIR, where it would have been looked up before —
# or ~/projects (where a clone lands) on a host with none, never "/$PROJECT".
PROJECT_DIR="$(remo_project_path "$PROJECT")" || PROJECT_DIR="${PROJECTS_DIR:-$HOME/projects}/$PROJECT"
if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "project-launch: project not found: $PROJECT_DIR" >&2
    exit 1
fi

HAS_DC=false
if [[ -d "$PROJECT_DIR/.devcontainer" ]] || [[ -f "$PROJECT_DIR/.devcontainer.json" ]]; then
    HAS_DC=true
fi

REMO_INSTANCE="$(hostname)"
export REMO_INSTANCE
export REMO_PROJECT="$PROJECT"

# ---------------------------------------------------------------------------
# Detached mode: no zellij, no interactive shell. Run EXEC_CMD in background.
# ---------------------------------------------------------------------------
if $DETACH; then
    if [[ -z "$EXEC_CMD" ]]; then
        echo "project-launch: --detach requires --exec SHELL_COMMAND" >&2
        exit 2
    fi

    LOG_DIR="$HOME/.local/state/remo"
    mkdir -p "$LOG_DIR"
    LOG_FILE="$LOG_DIR/$PROJECT.log"

    cd "$PROJECT_DIR"

    if $HAS_DC; then
        echo "Bringing up devcontainer for $PROJECT..."
        {{ devcontainer_cli_bin }} up --workspace-folder "$PROJECT_DIR" {{ devcontainer_up_extra_args }} >/dev/null
        printf -- '----- %s detached launch: %s -----\n' "$(remo_iso_now)" "$EXEC_CMD" >>"$LOG_FILE"
        remo_detach {{ devcontainer_cli_bin }} exec --workspace-folder "$PROJECT_DIR" \
            env REMO_INSTANCE="$REMO_INSTANCE" REMO_PROJECT="$PROJECT" \
            bash -lc "$EXEC_CMD" >>"$LOG_FILE" 2>&1 </dev/null &
    else
        printf -- '----- %s detached launch: %s -----\n' "$(remo_iso_now)" "$EXEC_CMD" >>"$LOG_FILE"
        remo_detach env REMO_INSTANCE="$REMO_INSTANCE" REMO_PROJECT="$PROJECT" \
            bash -lc "$EXEC_CMD" >>"$LOG_FILE" 2>&1 </dev/null &
    fi

    echo "Launched detached in $PROJECT (log: $LOG_FILE)"
    exit 0
fi

# ---------------------------------------------------------------------------
# Interactive mode.
# Cases:
#   1. Project HAS .devcontainer, no EXEC_CMD  → zellij + devcontainer
#                                                auto-start drops you into
#                                                devcontainer shell
#   2. Project HAS .devcontainer, EXEC_CMD     → zellij + devcontainer block
#                                                runs EXEC_CMD via bash -lc
#                                                (REMO_DEVCONTAINER_CMD)
#   3. Project has NO .devcontainer, no CMD    → zellij with plain shell in
#                                                project dir
#   4. Project has NO .devcontainer, EXEC_CMD  → skip zellij, run via bash
#                                                -lc directly on host
# ---------------------------------------------------------------------------
cd "$PROJECT_DIR"

if ! $HAS_DC && [[ -n "$EXEC_CMD" ]]; then
    # Case 4: bypass zellij, run command on host via login shell
    exec env REMO_INSTANCE="$REMO_INSTANCE" REMO_PROJECT="$PROJECT" \
        bash -lc "$EXEC_CMD"
fi

EXEC_STATUS_FILE=""
if [[ -n "$EXEC_CMD" ]]; then
    # Case 2: pass command through the env var remo-session-shell
    # honors and runs via `bash -lc`.
    export REMO_DEVCONTAINER_CMD="$EXEC_CMD"
    # The command runs in the session's pane, so its exit status never reaches
    # zellij's own: remo-session-shell writes it to this per-launch file and it
    # is read back below (spec 029 US3 #2, issue #279). mktemp makes the name
    # unique per invocation; the shell writes only to a file that still exists,
    # so a pane finishing after this launch has stopped waiting leaves nothing.
    _status_dir="$HOME/.local/state/remo/exec-status"
    mkdir -p "$_status_dir"
    EXEC_STATUS_FILE="$(mktemp "$_status_dir/launch.XXXXXX")"
    export REMO_EXEC_STATUS_FILE="$EXEC_STATUS_FILE"
    trap 'rm -f "$EXEC_STATUS_FILE"' EXIT
fi

# Clean up any exited session of the same name (mirrors project-menu)
if zellij list-sessions 2>/dev/null | remo_strip_ansi | grep -q "^$PROJECT.*EXITED"; then
    zellij delete-session "$PROJECT" 2>/dev/null || true
fi

# Remember which project this terminal tab attached, so `remo resume` can put
# the tab back (spec 028). REMO_TAB_KEY only arrives from a `remo` CLI tab —
# the web console and SSM connector never set it — and a failed record must
# never keep the user out of their session.
if [ -n "${REMO_TAB_KEY:-}" ]; then
    "$HOME/.local/bin/remo-host" sessions record --key "$REMO_TAB_KEY" --project "$PROJECT" >/dev/null 2>&1 || true
fi

# The session's shell is remo-session-shell (--default-shell, applied when the
# session is created): it starts the devcontainer for a devcontainer project and
# otherwise hands over to the user's login shell. No rc file is involved.
if [[ -z "$EXEC_STATUS_FILE" ]]; then
    exec zellij attach --create "$PROJECT" options \
        --default-shell "$HOME/.local/bin/remo-session-shell" \
        --default-cwd "$PROJECT_DIR"
fi

# --exec: wait for the session, then exit with the command's status. An empty
# file means the command never reported one (the user detached, or the session
# already existed and so never ran it): zellij's own status stands, as before.
_zellij_rc=0
zellij attach --create "$PROJECT" options \
    --default-shell "$HOME/.local/bin/remo-session-shell" \
    --default-cwd "$PROJECT_DIR" || _zellij_rc=$?
_exec_status="$(cat "$EXEC_STATUS_FILE" 2>/dev/null || true)"
rm -f "$EXEC_STATUS_FILE"
if [[ "$_exec_status" =~ ^[0-9]+$ ]]; then
    exit "$_exec_status"
fi
exit "$_zellij_rc"

#!{{ remo_bash_path | default('/bin/bash') }}
# remo-session-shell - the shell of a project's Zellij session.
# Managed by Ansible - do not edit manually
#
# project-menu and project-launch create sessions with
#   zellij attach --create NAME options --default-shell <this script> --default-cwd PATH
# so this runs as the session's first pane, with ZELLIJ_SESSION_NAME = the
# project name. It replaces the devcontainer block that used to live in ~/.bashrc
# (spec 029): no rc file is involved, which is what lets a local machine use it.
#
#   - a project with a devcontainer config: bring the container up (rebuilding
#     when the config changed or .devcontainer-rebuild exists), run the user's
#     shell - or REMO_DEVCONTAINER_CMD - inside it, stop the container on exit,
#     and end the session;
#   - any other project: the user's login shell, in the project directory.
#
# Sessions created before the upgrade still start the user's login shell; the
# ~/.bashrc shim calls this script for them (REMO_SESSION_SHELL keeps it from
# running twice).

PROJECTS_DIR="{{ dev_workspace_dir }}"

export REMO_SESSION_SHELL=1

# Shared helpers (project index resolver, portability shims): beside this
# script, else in ~/.local/bin.
REMO_LIB_PATH="$(dirname "${BASH_SOURCE[0]}")/remo-lib.sh"
[ -r "$REMO_LIB_PATH" ] || REMO_LIB_PATH="$HOME/.local/bin/remo-lib.sh"
# shellcheck source=/dev/null
. "$REMO_LIB_PATH"

login_shell() {
    exec "${SHELL:-/bin/bash}" -l
}

# project-launch --exec waits on REMO_EXEC_STATUS_FILE for the command's exit
# status (zellij's own never carries it). Written only while the file exists:
# project-launch removes it once it stops waiting.
record_exec_status() {
    if [[ -n "${REMO_DEVCONTAINER_CMD:-}" ]] && [[ -n "${REMO_EXEC_STATUS_FILE:-}" ]] \
        && [[ -f "$REMO_EXEC_STATUS_FILE" ]]; then
        printf '%s\n' "$1" >"$REMO_EXEC_STATUS_FILE" 2>/dev/null || true
    fi
}

# Nothing to do outside a project session, or inside a devcontainer already.
if [[ -z "${ZELLIJ_SESSION_NAME:-}" ]] || [[ -n "${REMOTE_CONTAINERS:-}" ]]; then
    login_shell
fi

# The project resolves through the index first, then PROJECTS_DIR: it may live
# anywhere on the machine, not only under one root.
if ! _project_dir="$(remo_project_path "$ZELLIJ_SESSION_NAME")" || [[ ! -d "$_project_dir" ]]; then
    login_shell
fi

# A plain project keeps the directory Zellij started the pane in: the session's
# --default-cwd for its first pane, the focused pane's directory for a new one
# (as the user's own shell did before this script existed). Only the
# devcontainer path moves to the project root.
if [[ ! -d "$_project_dir/.devcontainer" ]] && [[ ! -f "$_project_dir/.devcontainer.json" ]]; then
    login_shell
fi
cd "$_project_dir" || login_shell

# A devcontainer needs a running container engine. Without one the runtime fails
# with a raw error and the pane closes; say how to start it and leave the user in
# a working shell instead (FR-018).
if command -v docker >/dev/null 2>&1 && ! remo_timeout 10 docker info >/dev/null 2>&1; then
    echo "The container engine is not running, so this project's devcontainer cannot start."
    echo "Start it, then re-open the project:"
    echo "  - Docker Desktop or OrbStack: open the app"
    echo "  - Colima:                     colima start"
    echo "  - Linux:                      sudo systemctl start docker"
    echo ""
    echo "Continuing in a plain shell in $_project_dir."
    echo ""
    login_shell
fi

# Check if devcontainer config has changed and needs rebuild
_hash_dir="$HOME/.cache/devcontainer-hashes"
_hash_file="$_hash_dir/$ZELLIJ_SESSION_NAME"
_rebuild_flag=""

# Compute hash of devcontainer config files
_current_hash=$(cat "$_project_dir/.devcontainer/devcontainer.json" \
    "$_project_dir/.devcontainer.json" \
    "$_project_dir/.devcontainer/Dockerfile" \
    "$_project_dir/.devcontainer/docker-compose.yml" \
    2>/dev/null | remo_sha256)

# Compare with stored hash
mkdir -p "$_hash_dir"
if [[ -f "$_hash_file" ]]; then
    _stored_hash=$(cat "$_hash_file")
    if [[ "$_current_hash" != "$_stored_hash" ]]; then
        echo "Devcontainer config changed, rebuilding..."
        _rebuild_flag="--remove-existing-container"
    fi
fi

# Also check for manual rebuild request
if [[ -f "$_project_dir/.devcontainer-rebuild" ]]; then
    echo "Manual rebuild requested..."
    _rebuild_flag="--remove-existing-container"
    rm -f "$_project_dir/.devcontainer-rebuild"
fi

echo "Starting devcontainer for $ZELLIJ_SESSION_NAME..."
# shellcheck disable=SC2086  # the extra args and rebuild flag are word lists
if ! {{ devcontainer_cli_bin }} up --workspace-folder "$_project_dir" {{ devcontainer_up_extra_args | default('') }} $_rebuild_flag; then
    echo ""
    echo "{{ devcontainer_cli_bin }} up failed. [Press any key to continue]"
    record_exec_status 1
    read -n 1 -s -r
    exit 1
fi

# Store current hash after successful start
echo "$_current_hash" > "$_hash_file"

echo ""
echo "Entering devcontainer (exit to return to host shell)..."
echo ""

# If REMO_DEVCONTAINER_CMD is set (project-launch passthrough), run that command
# inside the devcontainer instead of dropping into the user's shell. Wrapped in
# `bash -lc` so the user's command gets variable expansion, pipes, &&, and PATH
# from the devcontainer's login profile.
if [[ -n "${REMO_DEVCONTAINER_CMD:-}" ]]; then
    _bash_flags="-lc"
    _exec_cmd="$REMO_DEVCONTAINER_CMD"
else
    _bash_flags="-c"
    _exec_cmd='if command -v zsh &> /dev/null; then exec zsh; else exec bash; fi'
fi

# Run devcontainer shell (not exec, so we can stop container after)
_exec_rc=0
{{ devcontainer_cli_bin }} exec --workspace-folder "$_project_dir" \
    env REMO_INSTANCE="${REMO_INSTANCE:-$(hostname)}" \
        REMO_PROJECT="$ZELLIJ_SESSION_NAME" \
    /bin/bash $_bash_flags "$_exec_cmd" || _exec_rc=$?
record_exec_status "$_exec_rc"
if [[ "$_exec_rc" -ne 0 ]]; then
    echo ""
    if [[ -n "${REMO_DEVCONTAINER_CMD:-}" ]]; then
        echo "Command exited with status $_exec_rc. [Press any key to continue]"
    else
        echo "{{ devcontainer_cli_bin }} exec failed. [Press any key to continue]"
    fi
    read -n 1 -s -r
fi
unset _exec_rc
unset _exec_cmd _bash_flags

# After exiting devcontainer, stop the container(s) to free resources.
#
# `docker ps -q` prints one id PER LINE. This used to capture them into a scalar
# and pass the whole capture as ONE quoted argument - a newline-joined string
# docker rejects. With the error hidden by a trailing `|| true`, the stop
# silently became a no-op in exactly the case it mattered, more than one
# container left for this project, so duplicates compounded instead of being
# cleaned up. Read into an array and stop every one.
#
# NOTE: the bash array-length form (dollar, brace, hash) is deliberately avoided
# below. Ansible templates this file through Jinja2, which reads a brace-hash
# sequence as a comment opener and swallows everything after it; star expansion
# is the safe emptiness check. See the docstring of
# tests/unit/test_ansible_templates.py.
echo ""
echo "Stopping devcontainer..."
mapfile -t _container_ids < <(docker ps -q --filter "label=devcontainer.local_folder=$_project_dir")
if [[ -n "${_container_ids[*]}" ]]; then
    # Reported rather than silenced: a stop that fails while claiming success is
    # what hid this bug in the first place.
    if ! docker stop "${_container_ids[@]}" >/dev/null 2>&1; then
        echo "Warning: could not stop container(s): ${_container_ids[*]}" >&2
    fi
fi

# Exit the zellij session to return to project menu
exit 0

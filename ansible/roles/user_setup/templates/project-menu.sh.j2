#!{{ remo_bash_path | default('/bin/bash') }}
# project-menu - TUI menu for selecting/managing project zellij sessions
# Managed by Ansible - do not edit manually

set -e

PROJECTS_DIR="{{ dev_workspace_dir }}"

# Shared helpers (project index resolver, portability shims): beside this
# script, else in ~/.local/bin.
REMO_LIB_PATH="$(dirname "${BASH_SOURCE[0]}")/remo-lib.sh"
[ -r "$REMO_LIB_PATH" ] || REMO_LIB_PATH="$HOME/.local/bin/remo-lib.sh"
# shellcheck source=/dev/null
. "$REMO_LIB_PATH"

# Pin zellij's session namespace. zellij keeps session sockets in
# $XDG_RUNTIME_DIR/zellij, falling back to /tmp/zellij-$UID when that variable
# is unset — and ssh sets it only for a LOGIN SESSION (`ssh host`, a shell
# channel), not for `ssh host <command>`, which is what `remo shell -p`, the web
# console and the SSM connector all use. Without this the two contexts see
# different sessions on the same host: `remo shell` reattached while
# `remo shell -p NAME` created a duplicate in /tmp, and `remo-host sessions
# list` reported no active sessions to the console.
#
# Guarded on the directory existing, so a host without systemd-logind keeps
# today's /tmp fallback instead of pointing somewhere nothing will create.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
{% if remo_version %}
REMO_VERSION="{{ remo_version }}"
{% else %}
REMO_VERSION=""
{% endif %}

# Get list of active zellij sessions (excludes EXITED sessions)
get_active_sessions() {
    if command -v zellij &> /dev/null; then
        # Strip ANSI color codes, exclude EXITED sessions, and get session names
        zellij list-sessions 2>/dev/null | remo_strip_ansi | grep -v 'EXITED' | awk '{print $1}' || true
    fi
}

# Clean up exited zellij sessions
cleanup_exited_sessions() {
    if command -v zellij &> /dev/null; then
        # Get list of exited sessions and delete them
        local exited_sessions
        exited_sessions=$(zellij list-sessions 2>/dev/null | remo_strip_ansi | grep 'EXITED' | awk '{print $1}' || true)
        for session in $exited_sessions; do
            [ -n "$session" ] && zellij delete-session "$session" &>/dev/null || true
        done
    fi
}

# Load the project list (explicit index records + PROJECTS_DIR subdirectories)
# into parallel arrays. A malformed index is reported on stderr and leaves the
# list empty rather than showing a half-truth.
PROJ_NAMES=()
PROJ_PATHS=()
PROJ_STATUS=()
load_projects() {
    PROJ_NAMES=()
    PROJ_PATHS=()
    PROJ_STATUS=()
    local plist name path src pstatus
    plist="$(remo_project_list)" || return 0
    [ -n "$plist" ] || return 0
    while IFS=$'\t' read -r name path src pstatus; do
        [ -n "$name" ] || continue
        PROJ_NAMES+=("$name")
        PROJ_PATHS+=("$path")
        PROJ_STATUS+=("$pstatus")
    done <<<"$plist"
}

# The fix for a project whose folder is gone: re-add it elsewhere, or drop it.
missing_fix_hint() {
    local name="$1"
    if [ -f "$HOME/.local/state/remo/local.env" ]; then
        echo "  Fix: remo local add <new-path> --name $name   (or: remo local remove $name)"
    else
        echo "  Fix: remo-host projects remove --project $name --json"
    fi
}

# Get git status indicators for a project directory
# Returns: string with status symbols (e.g., "● ⇡" or "●" or "⇡" or "")
get_git_status_indicators() {
    local project_dir="$1"
    local indicators=""

    # Skip if not a git repo
    [ -d "$project_dir/.git" ] || return

    # Check for uncommitted changes (modified, staged, or untracked)
    if [ -n "$(git -C "$project_dir" status --porcelain 2>/dev/null)" ]; then
        indicators="●"
    fi

    # Check for unpushed commits (ahead of upstream)
    local ahead
    ahead=$(git -C "$project_dir" rev-list --count @{upstream}..HEAD 2>/dev/null || echo "0")
    if [ "$ahead" -gt 0 ]; then
        [ -n "$indicators" ] && indicators="$indicators "
        indicators="${indicators}⇡"
    fi

    # Check for unpulled commits (behind upstream)
    local behind
    behind=$(git -C "$project_dir" rev-list --count HEAD..@{upstream} 2>/dev/null || echo "0")
    if [ "$behind" -gt 0 ]; then
        [ -n "$indicators" ] && indicators="$indicators "
        indicators="${indicators}⇣"
    fi

    echo "$indicators"
}

# Build menu options
build_menu_options() {
    local active_sessions
    local options=()

    # Clean up any exited sessions first
    cleanup_exited_sessions

    # Get active sessions as array
    mapfile -t active_sessions < <(get_active_sessions)

    # Get all projects (index records and PROJECTS_DIR subdirectories)
    load_projects

    # Fetch upstream for all git repos in parallel (so behind-count is fresh)
    local fetch_pids=()
    local i
    for i in "${!PROJ_NAMES[@]}"; do
        if [ "${PROJ_STATUS[$i]}" = "ok" ] && [ -d "${PROJ_PATHS[$i]}/.git" ]; then
            remo_timeout 10 git -C "${PROJ_PATHS[$i]}" fetch --quiet 2>/dev/null &
            fetch_pids+=($!)
        fi
    done
    for pid in "${fetch_pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done

    # Create associative array for quick lookup of active sessions
    declare -A active_map
    for session in "${active_sessions[@]}"; do
        [ -n "$session" ] && active_map["$session"]=1
    done

    # Blank separator (rendered as non-selectable header line by fzf --header-lines)
    options+=("")

    # Build options: show projects with git status and active indicators
    for i in "${!PROJ_NAMES[@]}"; do
        local dir="${PROJ_NAMES[$i]}"
        local indicators=""

        # A project whose folder is gone, or one hidden by an index record of
        # the same name, is shown as such and never launched.
        if [ "${PROJ_STATUS[$i]}" = "missing" ]; then
            options+=("$(printf '%s \033[31m✗ missing\033[0m' "$dir")")
            continue
        fi
        if [ "${PROJ_STATUS[$i]}" = "shadowed" ]; then
            options+=("$(printf '%s \033[33m⚠ shadowed\033[0m' "$dir")")
            continue
        fi

        # Add git status indicators
        local git_status
        git_status=$(get_git_status_indicators "${PROJ_PATHS[$i]}")
        [ -n "$git_status" ] && indicators="$git_status"

        # Add active indicator if session is running
        if [ -n "${active_map[$dir]:-}" ]; then
            [ -n "$indicators" ] && indicators="$indicators "
            indicators="${indicators}⚡"
        fi

        # Build display name with colored indicators
        if [ -n "$indicators" ]; then
            # Color the indicators: ● yellow, ⇡ cyan, ⇣ magenta, ⚡ green
            local colored
            colored=$(echo "$indicators" | sed \
                -e 's/●/\\033[33m●\\033[0m/g' \
                -e 's/⇡/\\033[36m⇡\\033[0m/g' \
                -e 's/⇣/\\033[35m⇣\\033[0m/g' \
                -e 's/⚡/\\033[32m⚡\\033[0m/g')
            options+=("$(printf '%s %b' "$dir" "$colored")")
        else
            options+=("$dir")
        fi
    done

    # Special options
    options+=("[Clone new repo]")
    options+=("[Exit to shell]")
    options+=("")
    options+=("$(printf '\033[36mLegend:  \033[33m●\033[36m changes  \033[36m⇡\033[36m push  \033[35m⇣\033[36m pull  \033[32m⚡\033[36m active\033[0m')")

    printf '%s\n' "${options[@]}"
}

# Generate the banner text
get_banner() {
    local banner=""
    if command -v figlet &> /dev/null; then
        # Trim leading/trailing blank lines from figlet output
        banner=$(figlet -f slant "remo" 2>/dev/null | sed '/^[[:space:]]*$/d')
    fi
    
    if [ -z "$banner" ]; then
        # Fallback ASCII art if figlet not installed or failed
        banner='   ____ ___ _ __ ___   ___  
  | __// _ \  _ ` _ \ / _ \ 
  | | |  __/ | | | | | (_) |
  |_|  \___|_| |_| |_|\___/ '
    fi
    echo "$banner"
}

# Display menu and get selection
show_menu() {
    local options
    local header
    options=$(build_menu_options)
    
    # Count the number of project entries (excluding special options, blank lines, legend)
    local project_count
    project_count=$(echo "$options" | grep -cEv '^\[|^$|Legend:' || true)
    
    # Build header with banner and version display
    if [ -n "$REMO_VERSION" ]; then
        header=$(printf '\033[36m%s\033[0m\n\n  \033[90m[ Remote Coding Server v%s ]\033[0m\n\nSelect a project (1-9, ↑↓, Enter | c=clone, d=delete, x=exit):' "$(get_banner)" "$REMO_VERSION")
    else
        header=$(printf '\033[36m%s\033[0m\n\n  \033[90m[ Remote Coding Server ]\033[0m\n\nSelect a project (1-9, ↑↓, Enter | c=clone, d=delete, x=exit):' "$(get_banner)")
    fi

    echo "$options" | fzf --reverse --no-info \
        --expect=d \
        --header="$header" \
        --header-lines 1 \
        --pointer=">" \
        --prompt="" \
        --color="header:bold" \
        --ansi \
        --bind="1:pos(1)+accept,2:pos(2)+accept,3:pos(3)+accept,4:pos(4)+accept,5:pos(5)+accept" \
        --bind="6:pos(6)+accept,7:pos(7)+accept,8:pos(8)+accept,9:pos(9)+accept" \
        --bind="c:pos($((project_count + 1)))+accept" \
        --bind="x:pos($((project_count + 2)))+accept"
}

# Ensure GitHub CLI is authenticated, prompting login if needed
ensure_gh_auth() {
    if ! command -v gh &> /dev/null; then
        return 1
    fi

    if gh auth status &>/dev/null; then
        return 0
    fi

    echo "" >&2
    echo "GitHub CLI is not authenticated." >&2
    echo "Logging in lets you clone private repos and push changes." >&2
    echo "" >&2

    if gh auth login >&2; then
        echo "" >&2
        echo "GitHub authentication successful!" >&2
        echo "" >&2
        return 0
    else
        echo "GitHub login skipped or failed. Public repos can still be cloned." >&2
        echo "" >&2
        return 1
    fi
}

# Handle cloning a new repo
# Note: User-facing messages go to stderr, only repo name goes to stdout
handle_clone() {
    local repo_url
    local repo_name

    # Prompt gh login if not authenticated (non-blocking - clone can still work for public repos)
    ensure_gh_auth

    echo "" >&2
    echo -n "Enter GitHub repo (owner/repo or URL): " >&2
    read -r repo_url

    if [ -z "$repo_url" ]; then
        echo "Cancelled." >&2
        return 1
    fi

    # Extract repo name from URL or owner/repo format
    repo_name=$(basename "$repo_url" .git)

    # PROJECTS_DIR, or ~/projects on a host registered without one.
    local clone_root="${PROJECTS_DIR:-$HOME/projects}"
    local target_dir="$clone_root/$repo_name"

    if [ -d "$target_dir" ] || remo_project_path "$repo_name" >/dev/null 2>&1; then
        echo "Error: Directory $target_dir already exists" >&2
        sleep 2
        return 1
    fi

    mkdir -p "$clone_root"
    echo "Cloning $repo_url to $target_dir..." >&2

    # Try gh first (better auth), fall back to git clone
    local clone_ok=false
    if command -v gh &> /dev/null && gh auth status &>/dev/null; then
        if gh repo clone "$repo_url" "$target_dir" >&2; then
            clone_ok=true
        fi
    fi

    if [ "$clone_ok" = false ]; then
        if ! git clone "$repo_url" "$target_dir" >&2; then
            echo "Error: Clone failed" >&2
            sleep 2
            return 1
        fi
    fi

    # Without a PROJECTS_DIR nothing would find the checkout: index it.
    if [ -z "$PROJECTS_DIR" ]; then
        remo_project_add "$target_dir" "$repo_name" >/dev/null 2>&1 || true
    fi

    echo "Cloned successfully!" >&2
    sleep 1

    # Return the repo name to stdout (for capture by caller)
    echo "$repo_name"
}

# Handle deleting a project
handle_delete() {
    local project_name="$1"
    local project_dir
    local warnings=()

    echo ""

    if ! project_dir="$(remo_project_path "$project_name")" || [ ! -d "$project_dir" ]; then
        # A stale index record (its folder is gone) can be dropped here.
        if remo_project_remove "$project_name" >/dev/null 2>&1; then
            echo "  Folder is gone; removed the stale index record for $project_name."
        else
            echo "  Not a project directory, skipping."
        fi
        sleep 1
        return 1
    fi

    # Check for uncommitted changes
    if [ -d "$project_dir/.git" ]; then
        local uncommitted
        uncommitted=$(git -C "$project_dir" status --porcelain 2>/dev/null)
        if [ -n "$uncommitted" ]; then
            local change_count
            change_count=$(echo "$uncommitted" | wc -l | tr -d ' ')
            warnings+=("$(printf '\033[33m  ⚠ %s uncommitted change(s)\033[0m' "$change_count")")
        fi

        # Check for unpushed commits
        local ahead
        ahead=$(git -C "$project_dir" rev-list --count @{upstream}..HEAD 2>/dev/null || echo "0")
        if [ "$ahead" -gt 0 ]; then
            warnings+=("$(printf '\033[33m  ⚠ %s unpushed commit(s)\033[0m' "$ahead")")
        fi
    fi

    # Check for active zellij session
    local has_session=false
    if zellij list-sessions 2>/dev/null | remo_strip_ansi | grep -v 'EXITED' | grep -q "^${project_name}\b"; then
        has_session=true
        warnings+=("$(printf '\033[32m  ⚡ Active zellij session (will be killed)\033[0m')")
    fi

    # Check for running devcontainer
    local container_id=""
    if command -v docker &>/dev/null; then
        container_id=$(docker ps -q --filter "label=devcontainer.local_folder=$project_dir" 2>/dev/null)
    fi
    if [ -n "$container_id" ]; then
        warnings+=("$(printf '\033[36m  🐳 Running devcontainer (will be stopped and removed)\033[0m')")
    fi

    # Display deletion summary
    printf '\033[1m  Delete project: %s\033[0m\n' "$project_name"
    echo ""
    if [ {{ '${#' }}warnings[@]} -gt 0 ]; then
        for w in "${warnings[@]}"; do
            printf '%b\n' "$w"
        done
        echo ""
    fi
    printf '  This will permanently delete %s\n' "$project_dir"
    echo ""
    printf '  Type "delete" to confirm: '
    read -r confirm

    if [ "$confirm" != "delete" ]; then
        echo "  Cancelled."
        sleep 1
        return 1
    fi

    echo ""

    # Stop and remove devcontainer if running
    if [ -n "$container_id" ]; then
        echo "  Stopping devcontainer..."
        docker rm -f "$container_id" &>/dev/null || true
    fi

    # Kill zellij session if active
    if [ "$has_session" = true ]; then
        echo "  Killing zellij session..."
        zellij kill-session "$project_name" &>/dev/null || true
        zellij delete-session "$project_name" &>/dev/null || true
    fi

    # Remove project directory
    echo "  Removing $project_dir..."
    rm -rf "$project_dir"
    remo_project_remove "$project_name" >/dev/null 2>&1 || true

    printf '\033[32m  ✓ Deleted %s\033[0m\n' "$project_name"
    sleep 1
}

# Launch or attach to a zellij session for a project
launch_session() {
    local project_name="$1"
    local project_dir
    # Same fallback as project-launch: never "/$project_name" on a host with
    # no PROJECTS_DIR (a clone there lands in ~/projects).
    project_dir="$(remo_project_path "$project_name")" || project_dir="${PROJECTS_DIR:-$HOME/projects}/$project_name"

    if [ ! -d "$project_dir" ]; then
        echo "Error: Project directory not found: $project_dir"
        if remo_project_path "$project_name" >/dev/null 2>&1; then
            missing_fix_hint "$project_name"
            sleep 4
        else
            sleep 2
        fi
        return 1
    fi

    echo "Launching $project_name..."

    # Clean up any exited session with this name before attaching
    if zellij list-sessions 2>/dev/null | remo_strip_ansi | grep -q "^$project_name.*EXITED"; then
        zellij delete-session "$project_name" 2>/dev/null || true
    fi

    # Always use zellij for every project
    # The session starts in the project directory
    # If it has a devcontainer, the shell inside will handle starting it
    cd "$project_dir"

    # Remember which project this terminal tab attached, so `remo resume` can
    # put the tab back (spec 028). Best-effort: never blocks the attach.
    if [ -n "${REMO_TAB_KEY:-}" ]; then
        "$HOME/.local/bin/remo-host" sessions record --key "$REMO_TAB_KEY" --project "$project_name" >/dev/null 2>&1 || true
    fi

    # Try to attach, and if it fails due to corrupted session layout, clean up and retry
    # remo-session-shell is the session's shell: it starts the devcontainer for
    # a devcontainer project and otherwise hands over to the login shell. Zellij
    # applies --default-shell/--default-cwd when it CREATES the session.
    local session_opts=(options --default-shell "$HOME/.local/bin/remo-session-shell" --default-cwd "$project_dir")
    if ! zellij attach --create "$project_name" "${session_opts[@]}" 2>&1; then
        echo "Session may be corrupted, cleaning up and retrying..."
        # Kill any orphaned zellij processes for this session
        zellij kill-session "$project_name" 2>/dev/null || true
        zellij delete-session "$project_name" 2>/dev/null || true
        # Remove corrupted session cache files
        rm -rf "$HOME/.cache/zellij"/*/session_info/"$project_name" 2>/dev/null || true
        # Retry creating a fresh session
        zellij attach --create "$project_name" "${session_opts[@]}"
    fi

    # Reset terminal state after zellij detach — zellij can leave the tty in
    # raw mode and bracketed paste enabled, breaking arrow keys and paste
    stty sane 2>/dev/null
    printf '\e[?2004l'
}

# Main menu loop
main() {
    # Verify fzf is available
    if ! command -v fzf &> /dev/null; then
        echo "Error: fzf is not installed."
        exit 1
    fi

    while true; do
        # show_menu outputs two lines due to --expect=d:
        # line 1 = key pressed ("d" or empty for normal accept)
        # line 2 = selected item
        local fzf_output
        fzf_output=$(show_menu) || {
            # User pressed Ctrl+C or Escape - exit with code 1
            echo ""
            exit 1
        }
        local key="${fzf_output%%$'\n'*}"
        local selection="${fzf_output#*$'\n'}"

        # A shadowed row is the PROJECTS_DIR folder hidden by an index record of
        # the same name: the name resolves to the RECORD, so neither launching
        # nor deleting it by name may act on that row. Matched on the row's
        # status suffix, never a substring a project name could contain.
        local plain_selection
        plain_selection=$(echo "$selection" | remo_strip_ansi)

        # Handle delete key
        if [ "$key" = "d" ]; then
            local project_name
            project_name=$(echo "$plain_selection" | sed -E 's/ (✗ missing|⚠ shadowed)$//; s/ [●⇡⇣⚡ ]+$//')
            case "$plain_selection" in
                *" ⚠ shadowed")
                    echo "'$project_name' here is a folder hidden by an index entry with the same name; rename or remove one first."
                    sleep 3
                    continue
                    ;;
            esac
            if [[ "$project_name" != \[* ]] && [[ "$project_name" != *Legend* ]] && [ -n "$project_name" ]; then
                handle_delete "$project_name"
            fi
            continue
        fi

        case "$selection" in
            "[Clone new repo]")
                local new_repo
                if new_repo=$(handle_clone); then
                    # Launch session for newly cloned repo
                    launch_session "$new_repo"
                fi
                ;;
            "[Exit to shell]")
                echo ""
                echo "Exiting to shell. Run 'project-menu' to return."
                exit 0
                ;;
            ""|*Legend:*)
                # Blank separator or legend line selected, ignore
                continue
                ;;
            *)
                # Extract project name (strip ANSI codes and status indicators)
                local project_name
                # Remove ANSI escape codes, then strip trailing indicators (● ⇡ ⚡ and spaces)
                project_name=$(echo "$plain_selection" | sed -E 's/ (✗ missing|⚠ shadowed)$//; s/ [●⇡⇣⚡ ]+$//')
                case "$plain_selection" in
                    *" ⚠ shadowed")
                        echo "'$project_name' is hidden by an index entry with the same name; rename or remove one."
                        sleep 3
                        continue
                        ;;
                esac
                launch_session "$project_name"
                ;;
        esac

        # After detaching from zellij, loop back to show menu again
    done
}

# Run main if executed directly (not sourced)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
